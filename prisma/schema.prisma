// Prisma schema — CC-Quality QA Scorecard system.
// Datasource + generator only for now; domain models are added in task 2.0
// (Domain Data Model & Persistence Layer). See tasks/tasks-prd-qa-scorecard-system.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
