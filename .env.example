# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Database ----
# PostgreSQL connection string used by Prisma (datasource `db`).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/cc_quality?schema=public"

# ---- Email (agent "call scored" notifications) ----
# Base URL used in email links (where agents view their scores).
APP_URL="http://localhost:3000"
# SMTP transport. Leave SMTP_HOST unset to run in dev mode (emails are logged to
# the server console instead of being sent — no mail server required).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # "true" for port 465 (implicit TLS)
# SMTP_USER="apikey-or-username"
# SMTP_PASS="secret"
# MAIL_FROM="CC-Quality <no-reply@yourdomain.com>"
